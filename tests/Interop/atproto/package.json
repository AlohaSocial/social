{
  "name": "social-interop-atproto",
  "private": true,
  "description": "Starts the official Bluesky development network for interop, and verifies OAuth and app-password sign-in with the official AT Protocol clients.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/bsky": "0.3.8",
    "@atproto/dev-env": "0.6.30",
    "@atproto/lex-password-session": "0.3.0",
    "@atproto/oauth-client-node": "0.5.12"
  },
  "overrides": {
    "@fastify/busboy": "3.2.2",
    "@opentelemetry/instrumentation-cassandra-driver": "0.66.0",
    "@opentelemetry/instrumentation-knex": "0.65.0",
    "@opentelemetry/instrumentation-mongoose": "0.67.0",
    "@opentelemetry/instrumentation-mysql": "0.67.0",
    "@opentelemetry/instrumentation-mysql2": "0.67.0",
    "@opentelemetry/instrumentation-oracledb": "0.46.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/instrumentation-tedious": "0.40.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "kysely": "0.29.7",
    "nodemailer": "10.2.1",
    "sharp": "0.35.5",
    "@connectrpc/connect-node": {
      "undici": "6.29.1"
    },
    "zod": "4.6.6"
  }
