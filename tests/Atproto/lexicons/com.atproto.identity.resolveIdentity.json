{
  "lexicon": 1,
  "id": "com.atproto.identity.resolveIdentity",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["identifier"],
        "properties": { "identifier": { "type": "string", "format": "at-identifier" } }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "com.atproto.identity.defs#identityInfo" }
      },
      "errors": [
        { "name": "HandleNotFound" },
        { "name": "DidNotFound" },
        { "name": "DidDeactivated" }
      ]
    }
  }
}
