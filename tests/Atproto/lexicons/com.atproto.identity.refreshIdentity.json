{
  "lexicon": 1,
  "id": "com.atproto.identity.refreshIdentity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Re-resolves an identity without changing the account's repository or PLC state.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["identifier"],
          "properties": { "identifier": { "type": "string", "format": "at-identifier" } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "com.atproto.identity.defs#identityInfo" }
      },
      "errors": [
        { "name": "HandleNotFound" },
        { "name": "DidNotFound" },
        { "name": "DidDeactivated" }
      ]
    }
  }
}
