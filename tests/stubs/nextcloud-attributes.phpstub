namespace OCP\AppFramework\Http\Attribute {
	/**
	 * Psalm's constant resolver currently drops the repeatable bit from the
	 * OCP attribute's `Attribute::TARGET_METHOD | Attribute::IS_REPEATABLE`
	 * expression. Keep the equivalent flags explicit. PHP 8.5 added
	 * `Attribute::TARGET_CONSTANT`, which moves `IS_REPEATABLE` from 64 to 128.
	 */
	#[\Attribute(\Attribute::TARGET_METHOD | (PHP_VERSION_ID >= 80500 ? 128 : 64))]
	class FrontpageRoute extends Route {
		public function __construct(
			protected string $verb,
			protected string $url,
			protected ?array $requirements = null,
			protected ?array $defaults = null,
			protected ?string $root = null,
			protected ?string $postfix = null,
		) {
			parent::__construct(Route::TYPE_FRONTPAGE, $verb, $url, $requirements, $defaults, $root, $postfix);
		}
	}
}
